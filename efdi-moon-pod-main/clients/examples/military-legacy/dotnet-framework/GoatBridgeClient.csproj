<?xml version="1.0" encoding="utf-8"?>
<!--
  Old-style (non-SDK) MSBuild project for .NET Framework 4.x.

  This is the classic <Import Microsoft.CSharp.targets /> project shape that ships with every
  Visual Studio / Build Tools install going back over a decade — NOT the modern SDK-style csproj.
  It references only mscorlib / System (the BCL), so there is NOTHING to NuGet-restore and it builds
  fully offline.

  Build with MSBuild (any VS 2015+ or Build Tools install):
      msbuild GoatBridgeClient.csproj /p:Configuration=Release
  -> produces bin\Release\GoatBridgeClient.exe

  Or skip MSBuild entirely and use csc.exe directly (see README.md).
-->
<Project ToolsVersion="4.0" DefaultTargets="Build"
         xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputType>Exe</OutputType>
    <RootNamespace>GoatBridgeClient</RootNamespace>
    <AssemblyName>GoatBridgeClient</AssemblyName>
    <!-- 4.x: use whatever your shop pins (v4.5 / v4.6.1 / v4.7.2 / v4.8 are all fine). -->
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <!-- Only BCL references — System.Net.HttpWebRequest lives in System.dll. No packages. -->
  <ItemGroup>
    <Reference Include="System" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
