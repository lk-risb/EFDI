{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@eclipse-zenoh/zenoh-ts": ["./node_modules/@eclipse-zenoh/zenoh-ts/dist/index.d.ts"]
    }
  },
  "include": ["*.ts", "../../../connect/typescript/*.ts"]
}
