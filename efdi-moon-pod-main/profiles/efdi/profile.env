# Profile: efdi (EFDI sandbox goatnet — per-uuid slot-pool fabric).
#
# Concrete fallback values for standing a partner moon-pod up against the live EFDI fabric. EFDI
# is a SANDBOX (not the production shape): enrollment is netbird setup-key based and the Zenoh
# write namespace is a per-uuid SLOT (not release/<partner>). None of this is canon; production
# deltas come from the production profile + the signed bundle (see docs/efdi-vs-production.md).
#
# The partner receives a netbird setup-key + a Zenoh slot cert in a signed join bundle from the
# operator onboarding flow. The BUNDLE is the source of truth: first-boot reads the router
# endpoint and the mTLS identity straight from it. The values below are only fallbacks for
# hand-driven validation when a field is absent from the bundle.

# --- Mesh client ---
# EFDI does not run a silent control plane on the sandbox; enrollment is a netbird setup-key, so
# the cleaner partner on-ramp is netbird-only.
GOAT_CLIENT_MODE=netbird-only

# --- Zenoh ---
# Endpoint the pod's router dials. The bundle's router_endpoint WINS when present; this is only
# the fallback for hand-driven validation. The router cert carries a matching DNS SAN so the pod
# can keep verify_name_on_connect.
ZENOH_FABRIC_ENDPOINT=tls/zenoh.efdi.netbird.efdi-backbone.net:7447
ZENOH_LOCAL_ENDPOINT=tls/127.0.0.1:7447

# ACL subject identity axis. On the EFDI sandbox the cert CN, the portal prefix, and the write
# namespace are ALL the uuid slot anchor (slot_id); the baked ACL keys write rules off the cert
# CN, so the axis is cert_common_names.
ZENOH_ACL_SUBJECT_AXIS=cert_common_names
# Pod's cert CN on the EFDI fabric = the uuid slot the portal assigns at onboarding (NOT a
# human-readable name). Fill from the onboarding response (slot_id / uri_san). The requested
# prefix is ignored by the per-uuid portal.
ZENOH_POD_CN=1851281db70ccc0409dad4ecfc874cf5

# --- Namespace ---
# EFDI write namespace is the per-uuid slot anchor: the pod may only write <slot_id>/**. There is
# no release/<partner>/ grant on the sandbox; a publish outside <slot_id>/ is silently denied.
# Set this to the slot_id the portal assigned at onboarding.
PARTNER_NAMESPACE=1851281db70ccc0409dad4ecfc874cf5
# Bilateral inbound prefix the fabric publishes TO the pod. On the sandbox there is no separate
# bilateral grant yet, so this defaults to the pod's own slot (first-boot falls back to
# PARTNER_NAMESPACE when unset). Set it only once a bilateral inbound channel is granted.
# INBOUND_NAMESPACE=

# --- Audit ---
AUDIT_RETENTION_DAYS=90

# --- PKI ---
# CA trust comes from the bundle (ca_roots) / --trust-roots — never compiled in.
