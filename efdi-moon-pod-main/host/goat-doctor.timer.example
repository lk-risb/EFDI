# moon-pod — host goat-doctor timer. Installed + enabled by first-boot.sh.
# Fires goat-doctor.service every DOCTOR_INTERVAL (default 60s).

[Unit]
Description=Run goat-moon-pod health probe periodically

[Timer]
OnBootSec=30s
OnUnitActiveSec=60s
Unit=goat-doctor.service

[Install]
WantedBy=timers.target
