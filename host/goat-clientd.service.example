# moon-pod — host systemd unit for the WireGuard mesh client (goat-clientd, the PRODUCTION
# mesh path; on the sandbox the mesh is stock netbird and this unit is unused — see
# ../docs/efdi-vs-production.md).
#
# first-boot.sh renders this template (envsubst over ${GOAT_CLIENT_MODE} + ${POD_STATE_DIR})
# into /etc/systemd/system/goat-clientd.service. The mesh client runs on the HOST (kernel
# WireGuard, boot-persistence, auto-reconnect) — not in a container. See ../docs/architecture.md.
#
# Flags verified against goat-client-v0.2.0's packaging/deb-headless unit: --headless +
# explicit --bundle/--socket/--trust-roots/--config. Mode comes from the config.toml the
# daemon reads at --config (not a --mode flag in the reference unit) — but --mode is a valid
# override, kept here so the profile's GOAT_CLIENT_MODE is authoritative for the pod. CRITICAL:
# point --bundle/--socket/--config at ${POD_STATE_DIR} so goat-clientd state lives on the
# partner's LUKS volume, NOT goat-clientd's default /var/lib/goat-client.

[Unit]
Description=goat-client mesh daemon (moon-pod)
Documentation=https://github.com/DesertGOAT/efdi-moon-pod
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
# Mode is profile-driven: wg-cp0-only | netbird-only | combined.
Environment=GOAT_CLIENT_MODE=${GOAT_CLIENT_MODE}
ExecStart=/usr/local/bin/goat-clientd --headless --mode ${GOAT_CLIENT_MODE} \
    --bundle ${POD_STATE_DIR}/goat-client/bundle.cbor \
    --socket /run/goat-client/ipc.sock \
    --config ${POD_STATE_DIR}/goat-client/config.toml
RuntimeDirectory=goat-client
StateDirectory=goat-client
Restart=always
RestartSec=5
# Least-privilege per goat-client's own unit: non-root service user + CAP_NET_ADMIN only
# (userspace wireguard-go). Create the user out-of-band, or run as root if kernel WG via
# wg-quick is required on this host.
User=goat-client
Group=goat-client
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
# /dev/net/tun is required for the userspace WireGuard fallback.
DeviceAllow=/dev/net/tun rw

[Install]
WantedBy=multi-user.target
