# placeholder documenting the fields the production profile must set once that design lands.
# Rename to profile.env and fill in when production shape is decided.

# GOAT_CLIENT_MODE=            # lean: netbird-only (Block 80 crutch; cleaner partner on-ramp). TBD.
# ZENOH_FABRIC_ENDPOINT=       # per-site plane / multi-router — TBD per ADR 0844 / ADR 0216.
# ZENOH_LOCAL_ENDPOINT=tls/127.0.0.1:7447
# ZENOH_ACL_SUBJECT_AXIS=      # CN today (F-124) vs URI-SAN (ADR 0844 direction) — TBD.
# ZENOH_POD_CN=                # or URI-SAN identity, depending on the axis above.
# PARTNER_NAMESPACE=release/<partner>
# INBOUND_NAMESPACE=release/goat   # bilateral prefix the fabric publishes to the pod — TBD.
# AUDIT_RETENTION_DAYS=        # prod tier (e.g. 2555 for 7y cold) — TBD.
