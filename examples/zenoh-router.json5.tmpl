// EFDI — pod-side Zenoh router config TEMPLATE.
//
// Rendered by host/first-boot.sh via `envsubst` into ${POD_STATE_DIR}/zenoh/config.json5.
// Every value below comes from compose/.env — nothing stack-specific is hardcoded.
//
// Placeholders (all supplied by first-boot.sh from compose/.env + scripts/gen-certs.sh output):
//   ${ZENOH_LOCAL_TCP_PORT}   plaintext TCP listen port for local-only clients (bridges, zenoh-admin GUI)
//   ${ZENOH_LISTEN_ENDPOINTS} JSON array of the two listen endpoints — mesh-facing port first
//                             (tls:// normally, tcp:// only for the plaintext EFDI LTU SANDBOX
//                             profile — see config.py's _TLS_PROFILES "plaintext" flag), then
//                             the local-only tcp:// loopback port. Pre-built as a whole array so
//                             the mesh-facing entry's scheme can vary by profile without a
//                             templating conditional (envsubst/str.replace have none).
//   ${ZENOH_CONNECT_ENDPOINTS} JSON list containing the explicitly configured remote endpoints
//                              this pod dials OUT, or [] when this pod is the fabric root
//   ${PARTNER_NAMESPACE}      the pod's first-party write/read prefix (its slot, or release/<partner>)
//   ${INBOUND_NAMESPACE}      the bilateral prefix the fabric publishes TO the pod (compose/.env-driven)
//   ${NAMESPACE_PREFIX}       deployment prefix (variable depth); pod writes under ${NAMESPACE_PREFIX}/${PARTNER_NAMESPACE}
//   ${NAMESPACE_ROOT}         first segment of the prefix; scopes mesh-wide federation/topology wildcards
//   ${DATA_TOPIC_ROOT}        runtime data publish root; may be the slot itself on the EFDI sandbox
//   ${LISTEN_CERT_PEM}        selected local listener certificate
//   ${LISTEN_KEY_PEM}         selected local listener key
//   ${CONNECT_CERT_PEM}       selected outbound connector certificate
//   ${CONNECT_KEY_PEM}        selected outbound connector key
//   ${CA_ROOTS_PEM}           selected fabric trust roots
//   ${ZENOH_VERIFY_NAME_ON_CONNECT}    true/false — verify the fabric endpoint's cert SAN against
//                                       the DNS name dialed (default false: gateway cert SAN binds
//                                       the mesh IP, not the DNS name)
//   ${ZENOH_PLUGINS_LOADING_ENABLED}   true/false — whether the storage_manager plugin loads at all
{
  mode: "router",

  // Local listen: mTLS for mesh-facing pod-side clients (audit-sink, peers) on every profile
  // except EFDI LTU SANDBOX (plaintext tcp:// there, by design), plaintext TCP for local-only
  // clients (bridges, zenoh-admin GUI) always — matches the "local-tcp" ACL subject below.
  // The local-only port binds loopback ONLY: local-tcp's ACL subject grants full
  // pod-firstparty/pod-inbound/pod-admin-introspect/pod-federation-config trust to
  // ANY tcp connection with no cert/credential check, so this port must never be
  // reachable off-box — every local-tcp client is itself a container on this same
  // host (network_mode: host shares the loopback across all of them). The mesh-facing
  // port's own scheme is baked into ZENOH_LISTEN_ENDPOINTS by _render_config(), not
  // hardcoded here, so it can be tcp:// too for the plaintext sandbox profile.
  listen: {
    endpoints: ${ZENOH_LISTEN_ENDPOINTS},
  },

  // Dial OUT to the remote fabric endpoint (a peer router, or nothing yet on an isolated pod).
  connect: {
    endpoints: ${ZENOH_CONNECT_ENDPOINTS},
  },

  transport: {
    link: {
      tls: {
        // Pod identity for BOTH directions: as a listener (local clients verify us) and as a
        // connector (the remote peer verifies us). CA roots are EFDI's own root, never compiled in.
        listen_certificate: "${LISTEN_CERT_PEM}",
        listen_private_key: "${LISTEN_KEY_PEM}",
        connect_certificate: "${CONNECT_CERT_PEM}",
        connect_private_key: "${CONNECT_KEY_PEM}",
        root_ca_certificate: "${CA_ROOTS_PEM}",
        enable_mtls: true,
        // Router/gateway cert SAN binds the mesh IP, not the DNS name we dial — match the
        // audit-subscriber + the sandbox router posture.
        verify_name_on_connect: ${ZENOH_VERIFY_NAME_ON_CONNECT},
        // Drop expired client certificates instead of leaving a stale mTLS
        // session alive until its next transport failure.
        close_link_on_expiration: true,
      },
    },
  },

  plugins_loading: {
    enabled: ${ZENOH_PLUGINS_LOADING_ENABLED},
    search_dirs: ["/", "/lib", "/opt/zenoh/plugins"],
  },

  // In-memory storage — new subscribers get last-known value per topic immediately via get().
  plugins: {
    storage_manager: {
      storages: {
        efdi_live: {
          // Runtime data root is configurable independently from the federation prefix.
          key_expr: "${DATA_TOPIC_ROOT}/**",
          volume: { id: "memory" },
        },
      },
    },
  },

  // Pod-side ACL: default-deny, mTLS-gated. The pod is the partner's own single-tenant box, so
  // this is the partner's own boundary — enforced locally, default-deny as good hygiene.
  access_control: {
    enabled: true,
    default_permission: "deny",
    rules: [
      {
        // The pod's own first-party data: publish + subscribe within its namespace, both flows.
        id: "pod-firstparty",
        messages: ["put", "delete", "declare_subscriber", "query", "declare_queryable", "reply"],
        flows: ["egress", "ingress"],
        permission: "allow",
        // Runtime data root is configurable independently from the federation prefix.
        key_exprs: ["${DATA_TOPIC_ROOT}/**"],
      },
      {
        // Inbound bilateral data from the fabric: subscribe/deliver only (no pod writes here).
        // Prefix is compose/.env-driven (${INBOUND_NAMESPACE}), never hardcoded to a stack.
        id: "pod-inbound",
        messages: ["declare_subscriber", "query", "put", "reply"],
        flows: ["egress", "ingress"],
        permission: "allow",
        key_exprs: ["${INBOUND_NAMESPACE}/**"],
      },
      {
        // Admin-space introspection: read-only (query/reply), no put/delete/subscribe —
        // lets a local mTLS client (e.g. the Zenoh admin GUI) read the router's own
        // session/transport info via `get("@/**")`. Never grants write access to @/**.
        id: "pod-admin-introspect",
        messages: ["query", "reply"],
        flows: ["egress", "ingress"],
        permission: "allow",
        key_exprs: ["@/**"],
      },
      {
        // Router federation (config push/pull + hop-by-hop relay + status
        // reporting + topology autodiscovery) rides @config/v1 +
        // @config/relay/v1 + @config/status/v1 + @topology
        // under EVERY pod's namespace, mesh-wide — a deliberate wildcard
        // covering all descendants, not just direct children. Reason:
        // federation trees run thousands of routers deep
        // (HQ -> child -> grandchild -> ...), and a push has to reach any
        // descendant regardless of hop count. Scoping this ACL to only
        // directly-registered children (an earlier, narrower version of this
        // rule) breaks exactly that: an intermediate hop with no ACL
        // awareness of a namespace two levels below it silently drops the
        // relay — confirmed by live testing. Enumerating every descendant in
        // every intermediate's ACL doesn't scale either (one new leaf router
        // would mean rewriting + restarting every router on its path to HQ).
        // The `@` prefix already excludes this traffic from pod-firstparty's
        // ${NAMESPACE_PREFIX}/${PARTNER_NAMESPACE}/** coverage (Zenoh doesn't match
        // wildcards across '@'-prefixed chunks — the same reason
        // pod-admin-introspect above needs its own rule for @/**) and from
        // the efdi_live storage plugin's retention (deliberate: config
        // payloads shouldn't be persisted as regular mesh data). This rule
        // only restores TRANSPORT reachability for that sub-tree — it does
        // not grant authority to apply anything: the receiving pod's
        // federation_apply.py independently verifies every envelope's
        // signature against its configured immediate parent
        // (ZENOH_ADMIN_TRUSTED_PARENT_CERT_PATH/_CN) before acting on it;
        // deeper authority is re-signed by each registered parent hop,
        // exactly like pod-firstparty already relies on payload-level trust
        // rather than ACL identity for everything else it covers. Every
        // participant able to reach this rule at all is already an mTLS peer
        // holding a cert issued by our own root CA (see the mtls-peer
        // subject below) or a same-host local-tcp client — a mesh-wide
        // relay-only wildcard here does not let an untrusted party touch
        // anything.
        //
        // put + declare_subscriber only — the feature is pure pub/sub
        // (federation_apply.py subscribes + puts, federation.py puts,
        // federation_status.py subscribes); it never uses Zenoh's
        // query/queryable/reply primitives, so granting those verbs on a
        // rule that ships to every pod's router would be a gratuitous
        // least-privilege violation.
        id: "pod-federation-config",
        messages: ["put", "declare_subscriber"],
        flows: ["egress", "ingress"],
        permission: "allow",
        key_exprs: ["${NAMESPACE_ROOT}/**/@config/v1", "${NAMESPACE_ROOT}/**/@config/relay/v1", "${NAMESPACE_ROOT}/**/@config/status/v1", "${NAMESPACE_ROOT}/**/@topology"],
      },
      {
        // Visibility into whatever's on the EFDI Backbone trial fabric, for
        // local-tcp bridges (backbone_bridge.py) and the admin GUI only —
        // never granted to mtls-peer, which also covers remote fabric
        // partners that have no business seeing trial-fabric traffic through
        // this pod. zenoh-router-backbone (a peer of this router, connected
        // via its own dedicated mTLS session against the real backbone) has
        // no ACL of its own by design, so this rule is the only thing
        // standing between "peered" and "actually readable by a local
        // process."
        //
        // "put" has to be here, not just "declare_subscriber" — confirmed
        // live (zero samples delivered despite a healthy, established
        // backbone session on both legs, until this was added).
        // zenoh-router-backbone reaches this router over the SAME plain-tcp
        // local port every bridge uses (${ZENOH_LOCAL_TCP_PORT}), so it is
        // "local-tcp" too, not "mtls-peer" — every backbone sample crosses
        // that link into this router as an ingress "put", and without "put"
        // granted here that hop silently drops it regardless of what any
        // subscriber elsewhere is allowed to declare. This does mean any
        // local-tcp process can also publish under "**" locally, but
        // local-tcp already carries that same blanket trust level for
        // pod-firstparty/pod-inbound/pod-federation-config above — this
        // isn't a new trust boundary, and the backbone fabric's own
        // wire-layer ACL still rejects any outbound write that doesn't match
        // our assigned vendor prefix regardless of what happens locally.
        id: "pod-backbone-read",
        messages: ["put", "delete", "declare_subscriber", "query", "declare_queryable", "reply"],
        flows: ["egress", "ingress"],
        permission: "allow",
        key_exprs: ["**"],
      },
    ],
    subjects: [
      {
        // Any mTLS peer rooted in the EFDI root CA (pod-local clients + remote fabric peers).
        id: "mtls-peer",
        link_protocols: ["tls"],
      },
      {
        // Local plaintext TCP clients (bridges + local tooling on the pod's own host).
        id: "local-tcp",
        link_protocols: ["tcp"],
      },
    ],
    policies: [
      { rules: ["pod-firstparty", "pod-inbound", "pod-admin-introspect", "pod-federation-config"], subjects: ["mtls-peer"] },
      { rules: ["pod-firstparty", "pod-inbound", "pod-admin-introspect", "pod-federation-config", "pod-backbone-read"], subjects: ["local-tcp"] },
    ],
  },
}
