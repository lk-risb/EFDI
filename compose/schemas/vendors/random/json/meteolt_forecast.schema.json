{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://efdi.ltu/schemas/json/meteolt_forecast.schema.json",
  "title": "meteo.lt forecast point",
  "description": "Published BY bridges/meteolt_forecast_bridge.py to {TOPIC_ROOT}/env/weather/station/meteolt/forecast/{place}/tracks/v1, one publisher per configured place, polled from api.meteo.lt's nearest future forecast timestamp.",
  "x-efdi-topic": "{TOPIC_ROOT}/env/weather/station/meteolt/forecast/{place}/tracks/v1",
  "x-efdi-producer": "bridges/meteolt_forecast_bridge.py",
  "x-efdi-consumer": "layers/tak_layer.py (weather-station CoT, 3600s stale_s)",
  "type": "object",
  "required": ["place_name", "place_code", "lat_deg", "lon_deg", "time_utc"],
  "properties": {
    "place_name": {"type": "string"},
    "place_code": {"type": "string", "description": "meteo.lt's own place code, used as the {place} topic segment."},
    "lat_deg": {"type": "number", "minimum": -90, "maximum": 90},
    "lon_deg": {"type": "number", "minimum": -180, "maximum": 180},
    "time_utc": {"type": "string", "description": "meteo.lt's forecastTimeUtc for this point, as returned by the API (ISO-8601-like string, not reformatted)."},
    "temperature_c": {"type": ["number", "null"]},
    "apparent_temperature_c": {"type": ["number", "null"]},
    "relative_humidity_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "precipitation_mm": {"type": ["number", "null"], "minimum": 0},
    "wind_speed_ms": {"type": ["number", "null"], "minimum": 0},
    "wind_direction_deg": {"type": ["number", "null"], "minimum": 0, "maximum": 360},
    "wind_gusts_ms": {"type": ["number", "null"], "minimum": 0},
    "cloud_cover_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "pressure_hpa": {"type": ["number", "null"]},
    "condition_code": {"type": "string", "description": "meteo.lt's own condition code string; empty when not provided."}
  },
  "additionalProperties": false
}
