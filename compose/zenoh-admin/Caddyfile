{
	# Caddy's own internal CA — no external CA/ACME dependency required. Persisted
	# in the caddy_data volume so it survives container restarts (otherwise a new
	# CA would be minted every restart, forcing operators to re-trust it each time).
	local_certs
	# This is an admin console reached directly on :9443, not a public site —
	# no HTTP->HTTPS redirect is needed. Without this, Caddy still tries to
	# bind :80 for that redirect and crash-loops if anything else on the host
	# (network_mode: host, so it's the real host port) already holds it.
	auto_https disable_redirects
}

# NOT :8890 — that's SRT's real default port (compose/bridges/mediamtx/mediamtx.yml),
# and Caddy auto-binds matching UDP :8890 for HTTP/3 alongside this TCP
# listener, which crash-looped mediamtx's own SRT listener the instant SRT
# got turned on. This console moved off :8890 instead of asking every SRT
# source to use a non-default port.
:9443 {
	# on_demand: operators reach this by raw IP (no DNS name), so Caddy can't know which
	# hostname/IP to pre-issue a cert for — mint one for whatever identifier connects.
	# Safe here since the issuer is the internal CA (local_certs), not public ACME.
	tls internal {
		on_demand
	}

	# WHEP (video tile playback) must be fetched from THIS already-trusted
	# HTTPS origin, not dialed directly against MediaMTX's own :8889 —
	# MediaMTX's WebRTC listener is plain HTTP by default (mediamtx.yml's
	# webrtcEncryption), and a plain http:// fetch from this HTTPS page gets
	# blocked outright by the browser's own mixed-content policy (a bare
	# "NetworkError when attempting to fetch resource", no further detail) —
	# independent of whether MediaMTX's port can actually serve the
	# request. Enabling webrtcEncryption instead just trades that failure
	# for a second self-signed cert operators have to manually trust on a
	# raw video port, AND resets to false (breaking video again) every time
	# mediamtx.yml's checked-in default gets pulled from git — proxying the
	# signaling call through Caddy (server-to-server, not browser-to-server,
	# so mixed-content rules don't apply) sidesteps the whole class of
	# problem for good, independent of that toggle. WebRTC's actual media
	# (ICE/UDP on webrtcLocalUDPAddress :8189) still flows directly between
	# the browser and MediaMTX either way — only the HTTP signaling request
	# is proxied here.
	handle_path /mediamtx-whep/* {
		reverse_proxy 127.0.0.1:8889
	}

	reverse_proxy 127.0.0.1:8895
}
