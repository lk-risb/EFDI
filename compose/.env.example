# moon-pod — compose environment.
# Copy to .env and populate. first-boot.sh writes this from the active profile + the bundle.
# .env is NOT committed (secrets + per-deployment values).

# Where the pod keeps state (certs, rocksdb, audit NDJSON, goat-cli profile, doctor output).
# MUST live on the partner's LUKS-encrypted volume.
POD_STATE_DIR=/var/lib/goat-moon

# Partner namespace prefix for the key-exprs (e.g. release/<partner>, or a sandbox slot prefix).
PARTNER_NAMESPACE=release/example-partner

# Stable id for this pod — audit-sink AUDIT_SUBSCRIBER_ID + metric label.
POD_ID=moon-pod

# Endpoint the audit-sink connects to (the local router). MUST be the router's MESH IP, not
# loopback — the audit-sink is a mode:client Zenoh peer and on network_mode:host a loopback
# endpoint triggers a TLS-listener conflict on :7447 (F-174). first-boot.sh resolves the mesh IP
# via `netbird status` and writes it here.
ZENOH_LOCAL_ENDPOINT=tls/100.64.0.1:7447

# Logging.
ZENOH_LOG=info

# goat-client mesh mode: wg-cp0-only | netbird-only | combined  (consumed by the HOST service).
GOAT_CLIENT_MODE=combined

# ── Giraffe AMB radar (ASTERIX CAT-48/34) ────────────────────────────────────
# CAT48_PORT is required. Lat/lon are optional: the bridge reads them from the
# CAT-34 I034/120 field the radar broadcasts on each rotation. Set them here
# only as a fallback for radars that do not transmit I034/120, or to get an
# immediate ATAK marker before the first CAT-34 message arrives.
# Mobile platforms (radar on a vehicle): leave lat/lon empty — position,
# speed, and course update automatically from the live CAT-34 stream.
CAT48_PORT=                    # UDP port the radar transmits on (e.g. 30048)
CAT48_RADAR_LAT=               # Fallback latitude  — WGS-84 decimal degrees (optional)
CAT48_RADAR_LON=               # Fallback longitude — WGS-84 decimal degrees (optional)
CAT48_RADAR_SAC=               # ASTERIX Source Area Code  (from radar config)
CAT48_RADAR_SIC=               # ASTERIX Source Identification Code (from radar config)
CAT48_RADAR_NAME=Giraffe AMB   # Display name shown in ATAK

# ── ASTERIX CAT-21 ADS-B (optional, co-located ADS-B ground station) ─────────
CAT21_PORT=

# ── ASTERIX CAT-20 MLAT (optional) ───────────────────────────────────────────
CAT20_PORT=

# ── TAK Server connection ────────────────────────────────────────────────────
# Option A — plaintext TCP over NetBird tunnel (default):
TAK_HOST=127.0.0.1
TAK_PORT=8087
# Option B — mutual TLS directly on port 8089 (generate certs: make add-service NAME=efdi-pod):
# TAK_HOST=100.64.x.x
# TAK_PORT=8089
# TAK_TLS=1
# TAK_CERT=/path/to/certs/efdi-pod/cert.pem
# TAK_KEY=/path/to/certs/efdi-pod/key.pem
# TAK_CA=/path/to/certs/efdi-pod/ca.pem

# ── SitaWare friendly-force tracking ─────────────────────────────────────────
SITAWARE_URL=
SITAWARE_USER=
SITAWARE_PASS=

# ── Link-16 JREAP-C ──────────────────────────────────────────────────────────
LINK16_PORT=
LINK16_TCP=                    # Set to 1 for TCP, empty for UDP

# ── MAVLink UAV telemetry ─────────────────────────────────────────────────────
MAVLINK_PORT=
MAVLINK_TCP=

# ── VMF MIL-STD-47001C ───────────────────────────────────────────────────────
VMF_PORT=
VMF_TCP=

# ── yr.no weather bridge — MET Norway ToS requires app name + contact email ──
YR_USER_AGENT=efdi-yr-bridge/1.0 your-contact@example.com

# ── Third-party API keys ──────────────────────────────────────────────────────
# aisstream.io API key — required by the aisstream-bridge service.
AISSTREAM_KEY=

# N2YO satellite tracker API key — required by n2yo-bridge. Free at https://www.n2yo.com/api/
N2YO_KEY=

# PurpleAir read API key — required by purpleair-bridge. Free at https://develop.purpleair.com/
PURPLEAIR_KEY=

# Copernicus Marine (CMEMS) credentials — required by cmems-bridge. Free at https://marine.copernicus.eu/
CMEMS_USER=
CMEMS_PASS=

# HERE Traffic Flow API key — required by here-traffic-bridge. Free at https://developer.here.com/
HERE_KEY=

# ICAO Dataservices NOTAM API key — required by notam-bridge. Free at https://dataservices.icao.int/
ICAO_NOTAM_KEY=

# FlightRadar24 API key — required by fr24-bridge. Free tier at https://fr24api.flightradar24.com/key-management
FR24_KEY=

# Windy.com Point Forecast API key — required by windy-bridge. Free at https://api.windy.com/
WINDY_KEY=
