# EFDI — compose environment.
# Copy to .env and populate by hand. first-boot.sh reads this file; it no longer writes it.
# .env is NOT committed (secrets + per-deployment values).

# Where the pod keeps state (certs, rocksdb, audit NDJSON, doctor output).
# Defaults to compose/state/ inside the repo (gitignored) if left unset — override here
# only if you want it somewhere else. On a real partner deployment, point this at the
# partner's LUKS-encrypted volume.
#POD_STATE_DIR=/var/lib/efdi-pod

# Partner namespace prefix for the key-exprs (e.g. release/<partner>, or a sandbox slot prefix).
# Certs for this namespace come from scripts/gen-certs.sh <namespace>.
PARTNER_NAMESPACE=example-router

# Deployment topic prefix. It may contain one or more path segments and is
# changeable later from the WebUI.
NAMESPACE_PREFIX=EFDI

# Runtime data publish prefix, separate from federation/topology naming. Leave blank for the
# slot-root contract (<PARTNER_NAMESPACE>/**); normally match NAMESPACE_PREFIX.
DATA_NAMESPACE_PREFIX=EFDI

# The legacy single parent/fabric endpoint this pod dials out to. Leave blank
# only for the fabric root; never point a router at its own listen endpoint.
ZENOH_FABRIC_ENDPOINT=

# Optional explicit Zenoh mesh links. Use a JSON array for redundant parent
# uplinks and/or same-level links. These are direct sessions only; NetBird
# reachability does not cause automatic Zenoh connections.
# Prefer stable mesh DNS names so address reassignment does not require a config
# change. Set the actual endpoints issued by the target fabric.
# ZENOH_FABRIC_ENDPOINTS='["tls/router-a.example.internal:7447","tls/router-b.example.internal:7447"]'

# Optional one-click WebUI fabric presets. Each value is a JSON endpoint array.
# Labels are display-only. Credentials remain in compose/certs/<profile>/.
EFDI_LOCAL_FABRIC_LABEL=Local fabric
EFDI_LOCAL_FABRIC_ENDPOINTS=[]
EFDI_LOCAL_FABRIC_PROFILE=ltu-local
EFDI_BACKBONE_FABRIC_LABEL=Backbone
EFDI_BACKBONE_FABRIC_ENDPOINTS=[]
EFDI_BACKBONE_FABRIC_PROFILE=backbone

# Stable id for this pod — audit-sink AUDIT_SUBSCRIBER_ID + metric label.
POD_ID=efdi-pod

# Endpoint the audit-sink connects to (the local router). MUST be the router's MESH IP, not
# loopback — the audit-sink is a mode:client Zenoh peer and on network_mode:host a loopback
# endpoint triggers a TLS-listener conflict on :7447 (F-174). first-boot.sh resolves the mesh IP
# via `netbird status`; falls back to loopback if NetBird isn't connected (no audit-sink running).
ZENOH_LOCAL_ENDPOINT=tcp/127.0.0.1:7448
ZENOH_LISTEN_PORT=7447
ZENOH_LOCAL_TCP_PORT=7448
# Which TLS profile a BRAND NEW pod boots into (examples/first-boot.sh only —
# an already-running pod switches profiles live via the WebUI's Zenoh Config
# page instead, no re-run needed). One of:
#   efdi      EFDI LTU (production) — this pod's own real mTLS identity,
#             generated by scripts/gen-certs.sh. Default.
#   backbone  EFDI BACKBONE SANDBOX — requires compose/certs/efdi-backbone/
#             to already be staged, or first-boot fails clearly instead of
#             rendering a broken config.
#   ltu-local EFDI LTU SANDBOX — genuinely plaintext, no cert material
#             needed at all; use this for a cert-free sandbox bring-up.
EFDI_ROUTER_TLS_PROFILE=efdi

# Logging.
ZENOH_LOG=info

# NetBird mesh (optional) — set only if this pod should join a NetBird network on first-boot.
# Leave unset if NetBird is already connected, or the pod runs fully local/offline.
#NETBIRD_SETUP_KEY=

# ── Generic UDP ingress with safe ASTERIX auto-dispatch ─────────────────────
# Every datagram is preserved on raw/udp/ingress. Complete ASTERIX data blocks
# are additionally routed to raw/asterix/catNN. Unknown payloads are not guessed.
UDP_INGRESS_PORT=50000
UDP_INGRESS_BIND=0.0.0.0
UDP_INGRESS_ALLOW_SOURCE=      # optional IPv4 address or CIDR; comma-separated
# Backward-compatible alias; leave empty in new deployments.
ASTERIX_PORT=
ASTERIX_BIND=0.0.0.0
ASTERIX_CATEGORIES=34,48       # comma-separated, e.g. 34,48,62 if the source also emits CAT-062
ASTERIX_MULTICAST_GROUP=       # optional IPv4 multicast group
ASTERIX_MULTICAST_INTERFACE=0.0.0.0  # local interface address for group join
ASTERIX_ALLOW_SOURCE=          # optional IPv4 address or CIDR; comma-separated

# Optional raw ASTERIX feed from another Zenoh router. The bridge subscribes to
# <root>/raw/asterix/catN and republishes complete validated frames locally.
# Plaintext is permitted only for an isolated test fabric.
ASTERIX_ZENOH_UPSTREAM_ENDPOINT=
ASTERIX_ZENOH_UPSTREAM_ROOT=   # defaults to this pod's complete topic root

# ── ASTERIX CAT-034/CAT-048 radar decode metadata ───────────────────────────
# The radar/gateway sends everything as one combined UDP dump to
# UDP_INGRESS_PORT above — there is no separate dedicated port per category.
# These fields are decode-time metadata only (site position, SAC/SIC), read
# from that single stream; they are not listener ports.
CAT48_RADAR_LAT=               # Fallback latitude  — WGS-84 decimal degrees (optional)
CAT48_RADAR_LON=               # Fallback longitude — WGS-84 decimal degrees (optional)
CAT34_RADAR_LAT=                # Single-radar fallback only; live I034/120 is preferred
CAT34_RADAR_LON=                # Single-radar fallback only; live I034/120 is preferred
CAT34_RADAR_NAME=               # Single-radar only; leave blank for mixed Giraffe/VERA feeds
CAT34_RADAR_RANGE_M=            # Operator-confirmed maximum; live I034/100 wins
CAT34_RADAR_PASSIVE=            # Set to 1 if this is a passive coherent location system
                                 # (e.g. VERA-NG) rather than an emitting radar — renders
                                 # with the Direction Finding CoT icon instead of Radar.
                                 # Single-radar only, same as CAT34_RADAR_NAME above.

# ── Aaronia AARTOS drone detection (RTSA-Suite PRO HTTP Server block) ──────
# The laptop exposes a documented REST API on the HTTP Server block wired to
# its Tracking output — see bridges/aartos_bridge.py's own docstring.
# RTSA-Suite PRO can run more than one HTTP Server block at once, each on its
# own port and each surfacing a different detection type — e.g. one block for
# the drone/airframe track (below) and a separate block for WiFi-based
# operator/controller position finding (AARTOS_WIFI_PORT). Both share the same
# laptop/host and the same downstream JSON decoder
# (protocols/vendors/aartos/aartos_json.py, service "aartos") — only the
# ingress port differs, so enable AARTOS_WIFI_PORT once that second block is
# turned on on the unit itself. Not every deployment has a second block —
# check /sample on any candidate port first (a live one returns real JSON, an
# unwired one returns "null" forever) rather than assuming a port is correct.
AARTOS_HOST=                   # required — the RTSA-Suite PRO laptop
AARTOS_PORT=54664              # drone/airframe detection block's port
AARTOS_MODE=stream             # "stream" (default), or "poll" if /stream never
                                # delivers a body on this deployment (GET /sample
                                # repeatedly instead — see AARTOS_POLL_INTERVAL_S)
AARTOS_POLL_INTERVAL_S=1.0     # poll mode only — seconds between GET /sample
AARTOS_WIFI_PORT=              # optional second block — WiFi/operator-position
                                # detection on the same host; shares AARTOS_HOST,
                                # AARTOS_MODE, and AARTOS_POLL_INTERVAL_S above.
                                # Leave unset if this deployment has no second block.

# A dedicated per-category port (CATNN_PORT/CATNN_TCP, e.g. for CAT-010 or a
# CAT-062 system-track feed) is still supported by
# protocols/vendors/asterix/cat.py for a deployment that genuinely gets a
# category on its own port — just not configured by default here, since this
# deployment's producer only sends the combined dump above.

# ── TAK Server connection ────────────────────────────────────────────────────
# Option A — plaintext TCP over NetBird tunnel (default):
TAK_HOST=
TAK_PORT=8087
# Option B — mutual TLS directly on port 8089 (generate certs: make add-service NAME=efdi-pod):
# TAK_HOST=tak.example.internal
# TAK_PORT=8089
# TAK_TLS=1
# TAK_TLS_SERVER_NAME=takserver
# TAK_CERT=/path/to/certs/efdi-pod/cert.pem
# TAK_KEY=/path/to/certs/efdi-pod/key.pem
# TAK_CA=/path/to/certs/efdi-pod/ca.pem
# Optional extra connection candidates, tried in order after TAK_HOST — e.g. a
# LAN IP and a Tailscale mesh IP, so a NetBird outage doesn't take TAK with it:
# TAK_HOST_FALLBACK=192.168.1.10
# TAK_HOST_TAILSCALE=100.x.x.x
# Emergency squawk / ship distress → GeoChat popup on every ATAK device is a
# separate optional service (layers/tak_alert_layer.py, same TAK_HOST/PORT/TLS
# above) — select it in start.sh's menu to enable it; not started by default.

# ── SitaWare HQ friendly-force tracking (inbound REST pull) ─────────────────
SITAWARE_URL=
SITAWARE_URL_FALLBACK=
# SITAWARE_URL_TAILSCALE=https://100.x.x.x:10006   # optional 3rd candidate, Tailscale mesh IP
# HTTPS is required for authenticated SitaWare traffic; certificate verification
# stays enabled unless a deployment explicitly overrides it for a trusted test CA.
SITAWARE_USER=
SITAWARE_PASS=
SITAWARE_API_PATH=                # deployment-specific; /rest/v2/units is not universal
SITAWARE_POLL_S=10
SITAWARE_TLS_VERIFY=1

# ── mainline.inc TERMINAL drone-fleet C2 (inbound WebSocket pull) ──────────
# Login endpoint/shape is UNVERIFIED against a real login attempt — see
# bridges/vendors/mainline/terminal_bridge.py's module docstring before relying
# on this in production.
MAINLINE_TERMINAL_URL=https://mainframe.dev.mainline.inc   # staging; swap to prod when known
MAINLINE_TERMINAL_USER=
MAINLINE_TERMINAL_PASS=

# ── Generic MAVLink drone command bridge (arm/takeoff/rtl/land/hold/goto) ──
# UNVERIFIED against real hardware — no drone/simulator was connected while
# this was written. See bridges/mavlink_command_bridge.py's module
# docstring for exactly what is and isn't confirmed. Scoped to generic
# MAVLink-speaking airframes (ArduPilot/PX4-class), not Autel's EVO Max
# (proprietary SDK, not MAVLink).
MAVLINK_ENDPOINT=udp:127.0.0.1:14550

# ── NATO NFFI / ADatP-36 (STANAG 5527) friendly-force XML ──────────────────
# NFFI XML publishers write complete documents below .../raw/nffi/*.
# Override only if the partner publishes under a different Zenoh key expression.
NFFI_INPUT_TOPIC=

# bridges/nffi_bridge.py — dials OUT to a partner's NFFI/FFI server (e.g. a
# SitaWare Headquarters "NFFI and FFI Manager" IP1/IP1 Classic/IP2/SIP3
# server instance) and republishes what it sends onto .../raw/nffi/*.
# UNTESTED against a real endpoint as of this writing — see nffi_bridge.py's
# own module docstring before relying on it. No default host/port exists.
NFFI_HOST=
NFFI_PORT=
NFFI_SOURCE_ID=sitaware        # segment under .../raw/nffi/{source-id}
# NFFI_TLS=1
# NFFI_CERT=/path/to/certs/efdi-pod/cert.pem
# NFFI_KEY=/path/to/certs/efdi-pod/key.pem
# NFFI_CA=/path/to/certs/efdi-pod/ca.pem
# NFFI_TLS_SERVER_NAME=

# ── SitaWare HQ (outbound NVG pull feed) — HQ polls this native Python service
SITAWARE_HQ_NVG_ENABLE=0
SITAWARE_HQ_NVG_BIND=127.0.0.1   # set 0.0.0.0 or the EFDI LAN/Tailscale IP for remote HQ
SITAWARE_HQ_NVG_PORT=8088
SITAWARE_HQ_NVG_PATH=/nvg
SITAWARE_HQ_NVG_USER=
SITAWARE_HQ_NVG_PASS=
SITAWARE_HQ_NVG_TLS_CERT=
SITAWARE_HQ_NVG_TLS_KEY=
SITAWARE_HQ_NVG_STALE_S=120
SITAWARE_HQ_NVG_MAX_TRACKS=10000
SITAWARE_HQ_NVG_ALLOW_ANONYMOUS=0
SITAWARE_HQ_NVG_ALLOW_INSECURE_HTTP=0  # isolated lab only; Basic Auth is cleartext

# ── INT-CORE (NATO Integration Core) ────────────────────────────────────────
# intcore_layer.py: EFDI tracks -> INT-CORE Topic (NVG 2.0.2 via TopicApi/SaveItems)
INTCORE_URL=                    # e.g. https://localhost — INT-CORE's nginx front, no trailing slash
INTCORE_API_KEY=                # TopicApi's ApiKey header value
INTCORE_TOPIC_ID=               # GUID of a pre-provisioned, NVG-2.0-schema-validated Topic
INTCORE_DATA_SOURCE_ID=efdi     # tags every SaveItems call — give this same value to whoever
                                 # configures EFDI-NVG-Topic's Subscription, so it can exclude
                                 # our own items server-side (see intcore-bridge note below)
INTCORE_TLS_VERIFY=1            # set 0 to skip certificate check (self-signed lab cert)
INTCORE_UI_URL=                 # e.g. https://intcore.example:44383 — INT-CORE's OWN web console
                                 # (Topics/Subscriptions/Dissemination/ADTs). EFDI's admin panel
                                 # only links out to it (new tab) — never reimplements it.
# intcore-bridge (bridges/intcore_bridge.py): INT-CORE Dissemination (HTTP Post
# ADT) -> Zenoh. Live-tested finding #1: TopicSubQueue (RabbitMQ) is NOT a
# safe integration point — it has exactly one legitimate consumer
# (IntCoreSubscriptionApi) and is a competing-consumer queue, so a second
# consumer there randomly steals messages from every Topic's real
# dissemination pipeline instead of getting a copy. The correct point,
# confirmed live and already proven for SW/TAK: a Subscription (bound to
# EFDI-NVG-Topic) -> Dissemination -> a dedicated HTTP Post ADT, configured
# INT-CORE-side to POST here. INTCORE_BRIDGE_BIND must be reachable from
# INT-CORE's containers (its Docker bridge gateway IP, not just localhost,
# if INT-CORE runs in Docker on this same host).
# Live-tested finding #2: the real HttpPostAdt POST body is raw NVG XML with
# NO envelope and no dataSourceId anywhere — confirmed by capturing an actual
# request. This bridge therefore has nothing to self-filter its own echoed
# items by; EFDI-NVG-Topic's Subscription MUST be configured (INT-CORE side)
# to exclude items whose dataSourceId equals INTCORE_DATA_SOURCE_ID above, or
# every track EFDI pushes will loop straight back in as if a NATO partner
# sent it. What legitimately survives lands on ordinary EFDI Zenoh track
# topics, so tak_layer.py/sitaware_layer.py fan it out to TAK/SitaWare same
# as any other source. If INT-CORE's own Topic is ALSO configured to
# disseminate straight to a C2 system EFDI already reaches directly (e.g.
# the same TAK Server tak_layer.py talks to), that system sees the track
# twice — a dissemination-target decision made on the INT-CORE side, not
# something this bridge can filter for.
INTCORE_BRIDGE_BIND=0.0.0.0
INTCORE_BRIDGE_PORT=8092
INTCORE_BRIDGE_PATH=/intcore/dissemination
INTCORE_BRIDGE_TOKEN=           # shared secret INT-CORE must send as X-EFDI-Token (confirmed
                                 # custom Adt headers pass through intact); set this, the
                                 # endpoint is unauthenticated POST otherwise
INTCORE_SOURCE=intcore          # _src / topic segment tag for relayed tracks

# ── SAPIENT / BSI Flex 335 ─────────────────────────────────────────────────
# Choose connector mode (HOST) or listener mode (LISTEN_PORT). The listener
# defaults to loopback; remote edge nodes require an explicit source CIDR/IP.
SAPIENT_HOST=
SAPIENT_PORT=7001
SAPIENT_LISTEN_PORT=
SAPIENT_BIND=127.0.0.1
SAPIENT_ALLOW_PEER=

# ── STANAG 4586 protocol source ─────────────────────────────────────────────
STANAG4586_HOST=
STANAG4586_PORT=4586
# The retained binary layout is deployment-specific and disabled by default.
# Set this only after comparing it with the target VSM ICD.
STANAG4586_PROFILE=

# ── STANAG 4609 SRT/KLV video ingest ───────────────────────────────────────
# Provide the SRT endpoint that carries MPEG-TS plus KLV metadata. This bridge
# only publishes metadata; it does not transcode the video essence.
STANAG4609_SRT_URL=
STANAG4609_SOURCE=stanag4609
# Optional: also relay the video/audio essence (unchanged, -c copy) into
# mediamtx (see below) so it shows up in the WebUI Streams tab and reaches
# TAK/SitaWare like a drone feed. Off by default. Uses ffmpeg's own `tee`
# muxer with onfail=ignore on the video leg, so a down/restarting mediamtx
# never affects KLV extraction — see bridges/4609_bridge.py's docstring.
# STANAG4609_VIDEO_RELAY_ENABLE=1
# STANAG4609_VIDEO_PATH=stanag4609

# ── mediamtx (drone RTMP video → TAK/SitaWare/WebUI) ────────────────────────
# No .env config needed for mediamtx itself — see
# compose/bridges/mediamtx/mediamtx.yml (RTMP ingest, RTSP/WebRTC egress,
# rolling 10-minute recordings) — editable directly from the WebUI's Streams
# tab (compose/zenoh-admin/api/streams.py). These three only matter for that
# tab's own container, and their defaults already match mediamtx.yml and its
# docker-compose bind mounts — override only if you changed those too.
# MEDIAMTX_API_URL=http://127.0.0.1:9997
# MEDIAMTX_RECORDINGS_DIR=/mediamtx-recordings
# MEDIAMTX_CONFIG_PATH=/mediamtx-config/mediamtx.yml

# Optional: a Mapbox access token switches the Terminal tab's live map from
# plain OSM raster to Mapbox's satellite-streets style, matching the real
# mainline.inc TERMINAL reference. Leave empty to keep using OSM.
MAPBOX_ACCESS_TOKEN=

# ── Raw transport ingress for Zenoh-native protocol translators ─────────────
# These own only the socket; the matching protocol process decodes raw bytes.
SAPIENT_ZENOH_RAW=0
SAPIENT_RAW_PORT=
SAPIENT_RAW_TOPIC=
STANAG4586_ZENOH_RAW=0
STANAG4586_RAW_PORT=
STANAG4586_RAW_TOPIC=

# ── Zenoh-native protocol translators ───────────────────────────────────────
CAP_INPUT_TOPIC=
CAP_ACTIVE_ONLY=1
GEOJSON_INPUT_TOPIC=
SPECTRUM_INPUT_TOPIC=
SENSOR_HEALTH_INPUT_TOPIC=
MISSION_ROUTE_INPUT_TOPIC=

# ── Third-party API keys ──────────────────────────────────────────────────────

# ── Zenoh admin GUI ────────────────────────────────────────────────────────
# The host-launched admin-control process exposes native bridge/layer lifecycle
# controls to the panel on loopback. Set a random token in real deployments;
# leave the URL unchanged unless the control process uses another port.
EFDI_CONTROL_URL=http://127.0.0.1:18896
# Recommended override for Runtime Control and the fixed-target break-glass
# shell. If left empty, both sides derive a local token from the required
# ZENOH_ADMIN_SECRET_KEY. Generate an explicit token with: openssl rand -hex 32
EFDI_CONTROL_TOKEN=<generate-a-random-token>
EFDI_SHELL_CONTROL_HOST=127.0.0.1
EFDI_SHELL_CONTROL_PORT=18897
# PostgreSQL backing store for the admin GUI's own users/sessions/audit log
# (separate from zenoh's own data plane). Runs as its own container
# (zenoh-admin-db); port defaults to 5433 to avoid clashing with any other
# PostgreSQL already bound to 5432 (this pod uses network_mode: host).
ZENOH_ADMIN_DB_USER=zenoh_admin
ZENOH_ADMIN_DB_PASSWORD=
ZENOH_ADMIN_DB_PORT=5433
# Where the database stores its data. MUST be local disk — never a path on
# POD_STATE_DIR if that lives on a shared/network filesystem (e.g. JuiceFS):
# FUSE writeback caching breaks the fsync durability every database needs.
# Defaults to <POD_STATE_DIR>/zenoh-admin/postgres, which is fine as long as
# POD_STATE_DIR itself is local; install.sh refuses to proceed if this
# resolves to a FUSE mount.
#EFDI_DB_DATA_DIR=/var/lib/efdi-pod/zenoh-admin/postgres

# Signs the GUI's JWTs — generate with: openssl rand -hex 32
ZENOH_ADMIN_SECRET_KEY=

# Only set this for local frontend dev (Vite dev server origin, e.g.
# http://localhost:5174) to allow cross-origin, credentialed API calls from
# it. Leave unset in production — prod serves the UI from the same origin as
# the API, so no cross-origin requests should ever be accepted there.
#ZENOH_ADMIN_DEV_CORS_ORIGIN=

# Name of this pod's zenoh-router container — the one zenoh-admin restarts and
# health-checks. Only override the default if you run more than one pod on a
# single Docker host (they'd otherwise all restart the same container). One
# pod per host (the normal case) can leave this unset.
#ZENOH_ROUTER_CONTAINER=efdi-pod-zenoh-router

# First superadmin account, created on first boot if ZENOH_ADMIN_FIRST_PASS is set.
ZENOH_ADMIN_FIRST_USER=admin
ZENOH_ADMIN_FIRST_PASS=

# Router federation (optional) — set these only if this pod should accept
# config pushes from a parent zenoh-admin instance. Leave all unset to
# reject all federated pushes (the safe default).
# Host path to the trusted parent's public transport certificate. Compose
# mounts this one public file at /certs/trusted-parent.pem; arbitrary bundle
# directories and CA private keys are never exposed to the WebUI container.
#ZENOH_ADMIN_TRUSTED_PARENT_HOST_CERT_PATH=/runtime/efdi-pki/trusted-parent-cert.pem
# Expected Subject CN on that cert — sanity-checked alongside the signature.
#ZENOH_ADMIN_TRUSTED_PARENT_CN=
# Explicit parent topology namespace. Managed enrollment writes this into the
# bootstrap automatically; set it only when migrating an older bundle.
#EFDI_PARENT_NAMESPACE=

# Optional router-local CA used by the host admin-control agent for managed
# child enrollment. These are HOST paths and are never mounted into zenoh-admin.
# Use a subordinate router CA in production; do not place an offline/global
# root key on a router. The chain file is what enrolled children receive.
#EFDI_ROUTER_CA_CERT_PATH=/runtime/efdi-pki/router-ca-cert.pem
#EFDI_ROUTER_CA_KEY_PATH=/runtime/efdi-pki/router-ca-key.pem
#EFDI_ROUTER_CA_CHAIN_PATH=/runtime/efdi-pki/router-ca-chain.pem
# Non-CA ECDSA policy signer used for delegation, topology, status, and
# management-command signatures. Its key is mounted only into zenoh-admin;
# it cannot issue certificates.
#EFDI_POLICY_SIGNER_CERT_PATH=/runtime/efdi-pki/policy-signer-cert.pem
#EFDI_POLICY_SIGNER_KEY_PATH=/runtime/efdi-pki/policy-signer-key.pem
# Stable identity trust domain shared by all managed routers.
#EFDI_TRUST_DOMAIN=efdi.global
# Optional online short-lived leaf issuer. Initialize it explicitly with
# scripts/pki/init-step-ca.sh, then start Compose profile managed-ca.
#EFDI_STEP_CA_PORT=9000
#EFDI_STEP_CA_STATE_PATH=/runtime/efdi-state/pki/step-ca
# On an enrolled child, point renewal at the parent router's step-ca. The
# launcher then starts the PID-managed renewer automatically.
#EFDI_STEP_CA_URL=https://parent-router.example:9000
#EFDI_STEP_RENEW_ROOT_PATH=/runtime/efdi-certs/efdi/efdi-ca-root.pem
#EFDI_STEP_RENEW_CERT_PATH=/runtime/efdi-certs/efdi/child-cert.pem
#EFDI_STEP_RENEW_KEY_PATH=/runtime/efdi-certs/efdi/child-key.pem
#EFDI_STEP_RENEW_RUNTIME_CERT_PATH=/runtime/efdi-state/zenoh/tls/pod-cert.pem
#EFDI_STEP_RENEW_CHECK_SECONDS=900
#EFDI_STEP_RENEW_BEFORE_SECONDS=28800
#EFDI_PROTOBUF_V2_CONSUME=1

# ── Optional OIDC / OAuth2 single sign-on (Keycloak, Authentik, any compliant
# provider) ─────────────────────────────────────────────────────────────────
# Leave OIDC_ISSUER/CLIENT_ID/CLIENT_SECRET unset to keep SSO disabled — the
# login page then shows password login only. Set all three to enable the
# "Sign in with <provider>" button. IdP groups map to panel roles; a user in
# no mapped group gets OIDC_DEFAULT_ROLE. SSO is prod-only: it needs an https
# redirect URL registered with the IdP (the session cookie is https-only).
#OIDC_ISSUER=https://auth.example.com/application/o/efdi
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
# Button label + which claim carries group membership.
#OIDC_PROVIDER_NAME=Authentik
#OIDC_SCOPES=openid profile email groups
#OIDC_GROUPS_CLAIM=groups
# Explicit callback URL registered with the IdP — required behind a reverse
# proxy (the app otherwise sees the internal http URL).
#OIDC_REDIRECT_URL=https://efdi.example.com/auth/oidc/callback
# "idp-group=panel-role" pairs (roles: superadmin|admin|readonly).
#OIDC_ROLE_MAP=efdi-superadmins=superadmin,efdi-ops=admin,efdi-ro=readonly
#OIDC_DEFAULT_ROLE=readonly
#OIDC_POST_LOGIN_URL=/
