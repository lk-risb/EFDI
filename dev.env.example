# Local dev/preview environment — zenoh-admin panel only, no real pod.
# Copy is generated automatically by `./dev.sh up` as `dev.env` (gitignored).
# This file documents the values; it is never read directly.

ZENOH_ADMIN_DB_ADDRESS=localhost:5433
ZENOH_ADMIN_DB_USER=devuser
ZENOH_ADMIN_DB_PASSWORD=devpass
ZENOH_ADMIN_SECRET_KEY=dev-only-not-for-production-use
ZENOH_ADMIN_FIRST_USER=admin
ZENOH_ADMIN_FIRST_PASS=devpass123
