# Local agent/editor state. Dot-prefixed names are not ignored by Git unless
# they are listed explicitly.
.ai/.claude/
.ai/.claude/.compound-engineering/
.claude/
.codex/
.agents/
.cursor/
.gemini/
.vscode/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
.ai/
register_topics.sh
compose/.env
# Keep the certificate layout and instructions reproducible while excluding
# every credential. Only the README files below may be tracked.
compose/certs/**
!compose/certs/
!compose/certs/README.md
!compose/certs/efdi/
!compose/certs/efdi/README.md
!compose/certs/efdi-ltu/
!compose/certs/efdi-ltu/README.md
!compose/certs/efdi-backbone/
!compose/certs/efdi-backbone/README.md
compose/state/
logs/
.pids/
# MediaMTX itself (downloaded binary, not source) and its recorded segments
compose/bridges/mediamtx/mediamtx
compose/bridges/mediamtx/recordings/
# Throwaway AI-agent / developer verification scripts. Never part of the
# product — see scratch/README.md.
scratch/*
!scratch/README.md
*.cbor
node_modules/
__pycache__/
compose/zenoh-admin/ui/dist/
compose/zenoh-admin/ui/src/routeTree.gen.ts
# compose/generated is a symlink (scripts/generate-protobuf.sh swaps it via a
# single rename onto a fresh compose/generated.XXXXXX mktemp dir each run) —
# the trailing-slash form here never matched the symlink itself, and the
# random suffix never matched either, so both slipped past git and got
# committed once (compose/generated + compose/generated.LjxNfM, removed in
# the same change that added this comment). Cover the symlink (no trailing
# slash, matches non-directories too) and every mktemp-suffixed sibling.
compose/generated
compose/generated.*
# docs/ is tracked (public guides + design notes). Only local/scratch stays out.
docs/superpowers/

# Local dev environment (dev.sh) — zenoh-admin panel preview only
dev.env
.dev-api.pid
.dev-api.log
.dev-ui.pid
.dev-ui.log
.dev-control.pid
.dev-control.log
.dev-runtime.env
.dev-state/
compose/zenoh-admin/.venv/

# JetBrains IDE settings — per-developer, not project state
.idea/
*.iml

# Stray backup files
*.bak

# Scratch commit-message drafts — working state, not project content
commit_msg.txt
COMMIT_MSG.txt
